# Claude API key — get yours at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pexels API key — free at pexels.com/api — enables video backgrounds in hero
# Without this, hero falls back to a full-screen Unsplash photo (still looks great)
PEXELS_API_KEY=your_pexels_api_key_here

# Cloudflare — enables one-click deploy to workers.dev (completely free tier)
# Get API token: dash.cloudflare.com/profile/api-tokens → "Edit Cloudflare Workers" template
# Get Account ID: dash.cloudflare.com → right sidebar on any zone page
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
