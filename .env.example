# Required: Anthropic API key for the agent brain
ANTHROPIC_API_KEY=sk-ant-...

# Optional: GoHighLevel Private Integration Token + location ID
# If unset, GHL tools no-op and the agent records intents as notes instead.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Run mode: scheduled (one cycle then exit) or forever (loop with sleeps)
AGENT_MODE=scheduled

# Forever-mode interval in seconds (default 15 minutes)
AGENT_INTERVAL_SECONDS=900

# Where to read/write state. Default "state" -- committed back by Actions.
AGENT_STATE_DIR=state
